#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime="$repository_root/plugins/agent-fleet-herdr/adapter/scripts/fleet-runtime"
core="$repository_root/plugins/agent-fleet-core/core/scripts/fleet-control"

AGENT_FLEET_RUNTIME_COMMAND="$repository_root/scripts/fleet-runtime" \
  exec "$runtime" "$@" --core-command "$core"
