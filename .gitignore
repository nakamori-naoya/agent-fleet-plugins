__pycache__/
*.pyc
*.sqlite3

# Repository-root allowlist
/*
!/LICENSE
!/SECURITY.md
!/.agents/
!/.claude-plugin/
!/.harness-plugins/
!/.github/
!/configs/
!/configs/**
!/docs/
!/plugins/
!/scripts/
!/tests/
!/tests/**
/tests/__pycache__/
/tests/**/*.pyc
!/AGENTS.md
!/README.md
!/.gitignore

# Secrets and local credentials at every depth
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
